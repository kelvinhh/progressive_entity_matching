# macOS
.DS_Store
._*

# Python bytecode and build outputs
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Virtual environments
.venv/
.venv_plot/
.venv_report/
venv/
env/

# Test, coverage, and analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Notebook checkpoints
.ipynb_checkpoints/

# Local editor settings
.idea/
.vscode/
*.swp
*.swo
*~

# Local secrets and machine-specific settings
.env
.env.*
!.env.example
!.env.template
*.pem
*.key

# Local datasets; retain documentation and small synthetic fixtures
data/*
!data/README.md
!data/.gitkeep
!data/fixtures/
!data/fixtures/**
datasets/

# Downloaded models, embeddings, and caches
models/
checkpoints/
embeddings/
.cache/
.huggingface/

# Experiment scratch outputs; keep curated results versioned
outputs/
runs/
logs/
wandb/
mlruns/
results/raw/
results/tmp/
*.log

# Temporary files
tmp/
temp/
*.tmp

# Imported reference archives remain local; fetch upstream from its cited URL.
references/upstream/
references/papers/*.pdf
